# Copy this file to ".env" and fill in your key.
GROQ_API_KEY=your_groq_api_key_here

# --- Optional settings (defaults shown) ---
# GROQ_MODEL=openai/gpt-oss-20b
# HEADLESS=true               # set to false to watch the browser window locally
# STEP_TIMEOUT=15             # seconds to wait for an element
# PAGE_LOAD_TIMEOUT=30
# MAX_CONCURRENT_RUNS=2       # simultaneous browser sessions
# ALLOW_LOCAL_URLS=false      # set to true to let plans open localhost / private IPs
# CHROME_BIN=                 # path to chrome/chromium if it is not auto-detected
# CHROME_DEBUG_PORT=          # e.g. 9222, only if you hit "DevToolsActivePort" errors in Docker
# HOST=127.0.0.1              # use 0.0.0.0 when deploying
# PORT=5000
# FLASK_DEBUG=0
